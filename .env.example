# ── Provider Selection ────────────────────────────────────────────────────
# Cloud / Render recommended: EMBEDDING_PROVIDER=local + LLM_PROVIDER=gemini
# Local Ollama fallback:     EMBEDDING_PROVIDER=ollama + LLM_PROVIDER=ollama (or AI_PROVIDER=ollama)
EMBEDDING_PROVIDER=local
LLM_PROVIDER=gemini

# ── Local BGE Embeddings (FastEmbed ONNX — 384 dims) ──────────────────────
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIM=384
LOCAL_EMBEDDING_THREADS=1

# ── Google Gemini API (Cloud LLM Generation) ──────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=3

# ── Ollama Configuration (Local Fallback) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
LLM_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# ── Retrieval Tuning ──────────────────────────────────────────────────────
TOP_K=5
# Calibrated cosine similarity threshold for local BAAI/bge-small-en-v1.5 embeddings (ollama=0.55)
RELEVANCE_THRESHOLD=0.68

# ── Flask Server ──────────────────────────────────────────────────────────
# SECRET_KEY must be set securely as a random secret in Render environment variables
SECRET_KEY=replace-with-a-long-random-secret-key
FLASK_DEBUG=false
HOST=0.0.0.0
# Render supplies PORT automatically at runtime (defaults to 5000 locally in config.py)

# ── Course Metadata ───────────────────────────────────────────────────────
COURSE_NAME=Sigma Web Development Course

# ── Optional Path Override ────────────────────────────────────────────────
# EMBEDDINGS_PATH=/absolute/path/to/embeddings_local.joblib
